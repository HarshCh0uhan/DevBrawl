# ──────────────────────────────────────────────────────────────────────────────
# DevBrawl Frontend - Environment Variables
# Copy to .env.local for local development
# ──────────────────────────────────────────────────────────────────────────────

# Backend API URL
VITE_API_URL=http://localhost:8000

# Socket.io URL (same as API for local)
VITE_SOCKET_URL=http://localhost:8000

# LiveKit (for voice/video calls)
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# Daily.co (alternative video)
VITE_DAILY_DOMAIN=your-domain.daily.co

# Feature Flags
VITE_ENABLE_VOICE=true
VITE_ENABLE_CANVAS=true
VITE_ENABLE_AI_SCORING=true