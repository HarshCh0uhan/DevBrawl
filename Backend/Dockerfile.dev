# ──────────────────────────────────────────────────────────────────────────────
# DevBrawl Backend - Development Dockerfile
# ──────────────────────────────────────────────────────────────────────────────

FROM node:20-alpine

WORKDIR /app

# Install dependencies for native modules
RUN apk add --no-cache python3 make g++

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Expose port
EXPOSE 8000

# Start with nodemon for hot reload
CMD ["npm", "run", "dev"]