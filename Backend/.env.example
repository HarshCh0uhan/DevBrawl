# ──────────────────────────────────────────────────────────────────────────────
# DevBrawl - Environment Configuration
# Copy this to .env and fill in your values
# ──────────────────────────────────────────────────────────────────────────────

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development

# ─── Database (MongoDB Atlas Free Tier M0) ────────────────────────────────────
# Get from: https://cloud.mongodb.com → Clusters → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net
DB_NAME=devbrawl

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-64-chars
JWT_EXPIRY=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-min-64-chars
JWT_REFRESH_EXPIRY=30d

# ─── AI Services (Google Gemini - FREE: 1,500 req/day) ────────────────────────
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# ─── AI Services (Groq - FREE: 14,400 req/day) ────────────────────────────────
# Get from: https://console.groq.com/keys
# Used as fallback for Gemini, or primary if AI_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key

# ─── AI Provider Selection ─────────────────────────────────────────────────────
# Options: 'gemini' | 'groq' | 'auto' (tries gemini first, falls back to groq)
AI_PROVIDER=auto

# ─── Code Execution (Piston API) ──────────────────────────────────────────────
# Option A: Public instance (rate limited) - https://emkc.org/api/v2/piston
# Option B: Your self-hosted Piston on Oracle Cloud (recommended)
PISTON_API_URL=https://emkc.org/api/v2/piston

# ─── File Storage (Cloudinary - FREE: 25GB storage, 25GB bandwidth) ───────────
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Real-time Communication (LiveKit Cloud - FREE: 10K participant min/mo) ───
# Get from: https://cloud.livekit.io
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_URL=wss://your-project.livekit.cloud

# ─── Video Calls Alternative (Daily.co - FREE: 10K min/mo) ────────────────────
# Get from: https://dashboard.daily.co
DAILY_API_KEY=your-daily-api-key

# ─── Frontend URL (for CORS) ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Oracle Cloud Deployment (optional) ───────────────────────────────────────
# If deploying to Oracle Cloud Always Free VM
ORACLE_VM_IP=your-vm-public-ip
DOMAIN=your-domain.com