# Server
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
MONGODB_URI=<your-mongodb-atlas-connection-string>

# Auth (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Run the command twice to get two DIFFERENT 64-character strings.
ACCESS_TOKEN_SECRET=<64-char-hex-string>
REFRESH_TOKEN_SECRET=<different-64-char-hex-string>
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Code Execution (OneCompiler via RapidAPI)
RAPIDAPI_KEY=<your-rapidapi-key>
RAPIDAPI_HOST=<your-rapidapi-host>

# AI Providers (Optional fallbacks)
GROQ_API_KEY=
OPENROUTER_API_KEY=
AI_PROVIDER=auto

# Cloudinary (Avatar uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# LiveKit (Voice chat)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
